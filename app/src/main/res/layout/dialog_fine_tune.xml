<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <!-- 月偏移 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="起始月偏移"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_m_minus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:textColor="@color/btn_secondary_text"
                app:backgroundTint="@color/btn_secondary"
                app:cornerRadius="12dp"
                android:text="-"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/tv_m_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textSize="18sp"
                android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_m_plus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:textColor="@color/btn_secondary_text"
                app:backgroundTint="@color/btn_secondary"
                app:cornerRadius="12dp"
                android:text="+"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- 周偏移 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="起始周偏移"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_w_minus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:textColor="@color/btn_secondary_text"
                app:backgroundTint="@color/btn_secondary"
                app:cornerRadius="12dp"
                android:text="-"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/tv_w_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textSize="18sp"
                android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_w_plus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:textColor="@color/btn_secondary_text"
                app:backgroundTint="@color/btn_secondary"
                app:cornerRadius="12dp"
                android:text="+"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- 日偏移 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="起始日偏移"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_d_minus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:textColor="@color/btn_secondary_text"
                app:backgroundTint="@color/btn_secondary"
                app:cornerRadius="12dp"
                android:text="-"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/tv_d_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textSize="18sp"
                android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_d_plus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:textColor="@color/btn_secondary_text"
                app:backgroundTint="@color/btn_secondary"
                app:cornerRadius="12dp"
                android:text="+"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="说明：偏移量直接作用于排班公式里的 d（天）、w（周）、m（月）三个变量。通用每周轮转模式只受「起始周偏移」影响。"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="注意：如果自定义公式没有用到对应变量（例如只写了 w，完全没写 d），那么调整该项不会有任何变化——这是正常的，不是失效。"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.DutyCall.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="100dp"
            android:text="取消" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:minWidth="100dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="保存"
            android:textColor="@color/action_text"
            app:backgroundTint="@color/action_bg" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
